{
  "name": "pneuma-shuimo",
  "version": "0.1.0",
  "description": "墨：一张空白的纸，一个活的墨圆。Agent 写一份 JSON，圆用毛笔把它写出来：自己的小品，或者一样能用的东西。播放器、脚本格式、校验、质检工具和教 Agent 写的 skill。",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./script": "./src/script.js",
    "./player.css": "./src/player.css"
  },
  "files": [
    "src",
    "skill",
    "examples",
    "pieces",
    "tools",
    "demo"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "demo": "node tools/serve.mjs",
    "check": "node tools/check.mjs examples/*.json",
    "film": "node tools/film.mjs pieces/*.json --out shots",
    "shoot": "node tools/shoot.mjs examples/*.json --out shots",
    "test": "node --test tests/"
  },
  "license": "MIT",
  "keywords": [
    "ink",
    "brush",
    "shuimo",
    "agent",
    "generative-ui",
    "canvas",
    "avatar"
  ],
  "engines": {
    "node": ">=22"
  }
}
